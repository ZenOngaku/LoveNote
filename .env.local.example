# LoveNote 环境变量示例
# 使用方法：复制本文件为 .env.local 并填入真实值
#   cp .env.local.example .env.local

# 项目 URL（Supabase Dashboard → Project Settings → API Keys → Project URL）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# 匿名公钥（Supabase Dashboard → Project Settings → API Keys → publishable / anon public）
# ⚠️ 请使用 publishable（anon）密钥，不要把 secret（service_role）密钥暴露在前端
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
